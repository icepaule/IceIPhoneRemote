diff --git a/hardware/hid_bridge/tcp_link.cpp b/hardware/hid_bridge/tcp_link.cpp
new file mode 100644
index 0000000..5434278
--- /dev/null
+++ b/hardware/hid_bridge/tcp_link.cpp
@@ -0,0 +1,163 @@
+// TCP replacement for the BLE link (same API as ble_link.h, so the HID and AirPlay code are untouched).
+// One authenticated client at a time on port 7300. Host -> board: text lines `<id> <command>`, the first one
+// `auth <token>`. Board -> host: frames [type u8][len u16 LE][payload], type 'R' reply line, 'S' status JSON,
+// 'V' video chunk (same chunk layout as docs/ble-protocol.md, payload up to 1400 bytes).
+#include "ble_link.h"
+#include <WiFi.h>
+#include <atomic>
+#if __has_include("secrets.h")
+#include "secrets.h"
+#endif
+#ifndef BRIDGE_TOKEN
+#error "TCP bridge needs BRIDGE_TOKEN in hid_bridge/secrets.h (see secrets.example.h)"
+#endif
+
+#if DEBUG_SERIAL
+#define TCP_LOG(...) Serial.printf("tcp: " __VA_ARGS__)
+#else
+#define TCP_LOG(...) ((void)0)
+#endif
+const uint16_t PORT = 7300;  // AirPlay uses 7000, 7010-7012 and 7100
+const size_t RX_MAX = 1024;
+const uint32_t AUTH_MS = 5000;
+const uint32_t VIDEO_TIMEOUT_MS = 1500, REPLY_TIMEOUT_MS = 3000, STATUS_TIMEOUT_MS = 300;
+
+static WiFiServer server(PORT);
+static WiFiClient client;
+static SemaphoreHandle_t txLock;
+static volatile bool authed, dropClient;
+static String rx;
+static uint32_t connectedAt;
+static uint32_t winStart, winBytes;
+static volatile uint32_t kbps;
+static std::atomic<uint32_t> drops, replyDrops;
+
+static bool constEq(const String &a, const char *b) {
+  size_t n = strlen(b);
+  uint8_t d = a.length() != n;
+  for (size_t i = 0; i < n; i++) d |= (i < a.length() ? a[i] : 0) ^ b[i];
+  return d == 0;
+}
+
+static bool writeAll(const uint8_t *p, size_t n, uint32_t timeoutMs) {
+  uint32_t start = millis();
+  while (n) {
+    size_t w = client.write(p, n);
+    p += w;
+    n -= w;
+    if (n && millis() - start > timeoutMs) return false;
+    if (n) delay(2);
+  }
+  return true;
+}
+
+// Callers run on different tasks; the loop task owns closing the socket (dropClient).
+static bool sendFrame(char type, const uint8_t *p, size_t n, uint32_t timeoutMs) {
+  if (!authed) return false;
+  xSemaphoreTake(txLock, portMAX_DELAY);
+  if (!authed) { xSemaphoreGive(txLock); return false; }  // the client was replaced while we waited
+  static uint8_t buf[3 + 1500];  // header + payload in one write: one TCP segment per frame
+  bool ok = !dropClient && n <= 1500;
+  if (ok) {
+    buf[0] = type; buf[1] = n; buf[2] = n >> 8;
+    memcpy(buf + 3, p, n);
+    ok = writeAll(buf, 3 + n, timeoutMs);
+  }
+  if (!ok) { authed = false; dropClient = true; TCP_LOG("tx failed, dropping client\n"); }
+  xSemaphoreGive(txLock);
+  return ok;
+}
+
+void ble_begin(const String &) {
+  txLock = xSemaphoreCreateMutex();
+  server.begin();
+  server.setNoDelay(true);
+}
+
+bool ble_connected() { return authed; }
+
+static void closeClient() {
+  TCP_LOG("close\n");
+  xSemaphoreTake(txLock, portMAX_DELAY);
+  authed = false;
+  client.stop();
+  dropClient = false;
+  rx = "";
+  xSemaphoreGive(txLock);
+}
+
+bool ble_pop_cmd(String &line, uint32_t wait_ms) {
+  uint32_t start = millis();
+  do {
+    if (dropClient) closeClient();
+    static uint32_t beat;
+    if (millis() - beat > 3000) { beat = millis(); TCP_LOG("alive authed=%d conn=%d\n", (int)authed, (int)client.connected()); }
+    WiFiClient c = server.accept();
+    if (c) {  // a new client replaces the old one
+      xSemaphoreTake(txLock, portMAX_DELAY);
+      authed = false;
+      client.stop();
+      client = c;
+      client.setNoDelay(true);
+      dropClient = false;
+      rx = "";
+      connectedAt = millis();
+      TCP_LOG("client accepted\n");
+      xSemaphoreGive(txLock);
+    }
+    if (authed && !client.connected()) { TCP_LOG("peer went away\n"); closeClient(); }
+    if (client.connected()) {
+      if (!authed && millis() - connectedAt > AUTH_MS) closeClient();
+      while (client.connected() && client.available() && rx.length() <= RX_MAX) rx += (char)client.read();
+      if (rx.length() > RX_MAX) closeClient();
+      int nl = rx.indexOf('\n');
+      if (nl >= 0) {
+        String l = rx.substring(0, nl);
+        rx = rx.substring(nl + 1);
+        l.trim();
+        if (authed) { line = l; return true; }
+        if (l.startsWith("auth ") && constEq(l.substring(5), BRIDGE_TOKEN)) {
+          authed = true;
+          TCP_LOG("authed\n");
+          ble_reply("0 ok auth");
+        } else {
+          closeClient();
+        }
+        continue;
+      }
+    } else if (client) {
+      closeClient();  // peer went away
+    }
+    delay(5);
+  } while (millis() - start < wait_ms);
+  return false;
+}
+
+void ble_reply(const String &line) {
+  if (!authed) return;
+  if (!sendFrame('R', (const uint8_t *)line.c_str(), line.length(), REPLY_TIMEOUT_MS)) replyDrops++;
+}
+
+void ble_status(const String &json) { sendFrame('S', (const uint8_t *)json.c_str(), json.length(), STATUS_TIMEOUT_MS); }
+
+size_t ble_video_room() { return authed ? 1400 : 0; }
+
+bool ble_video_send(const uint8_t *p, size_t n) {
+  if (!sendFrame('V', p, n, VIDEO_TIMEOUT_MS)) { drops++; return false; }
+  uint32_t now = millis();
+  winBytes += n;
+  if (now - winStart >= 1000) {
+    kbps = winBytes * 8 / (now - winStart);
+    winBytes = 0;
+    winStart = now;
+  }
+  return true;
+}
+
+void ble_unpair() {}
+uint16_t ble_mtu() { return 1500; }
+uint8_t ble_phy() { return 0; }
+uint32_t ble_kbps() { return millis() - winStart > 2000 ? 0 : kbps; }
+uint32_t ble_drops() { return drops; }
+uint32_t ble_reply_drops() { return replyDrops; }
+int ble_peers() { return authed ? 1 : 0; }
